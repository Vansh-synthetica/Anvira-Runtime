# ==========================================
# Nomi Environment Configuration
# ==========================================

# Environment Mode (development, testing, production)
ENVIRONMENT=development
APP_NAME=Nomi
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=nomi
POSTGRES_PASSWORD=nomi_super_secret_password
POSTGRES_DB=nomi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional full URL override:
# DATABASE_URL=postgresql+asyncpg://nomi:nomi_super_secret_password@postgres:5432/nomi

# --- Redis (Placeholder for future caching/sync layers) ---
REDIS_HOST=redis
REDIS_PORT=6379
# Optional full URL override:
# REDIS_URL=redis://redis:6379/0

# --- Security & JWT ---
# Generate a secure key in your terminal: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list or JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
